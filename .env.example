NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017,host3:27017/classy-men-rim?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mail (Gmail app password, 16 characters without spaces)
MAIL_USER=your_address@gmail.com
MAIL_APP_PASSWORD=your_app_password

# Auth (JWT)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed (used by `npm run seed:admin`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Client (Vite, exposed to the browser)
# Only used when set; enables the WhatsApp order button on the cart.
VITE_WHATSAPP_NUMBER=
